[node name="TutorialContentLabel" type="RichTextLabel" parent="OptionsModal/TutorialPanel/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/default_color = Color(0.929412, 0.913725, 0.847059, 1)
bbcode_enabled = true
text = "[b][color=#C9AE7C]Controles básicos[/color][/b]
• [b]WASD o Flechas:[/b] Moverse por los escenarios de Aldeavieja.
• [b]E (o clic izquierdo):[/b] Hablar con personajes, examinar objetos y activar mecanismos.
• [b]Q:[/b] Abrir o cerrar el [b]Cuaderno de Cera[/b] para revelar pistas ocultas y marcas doradas.
• [b]Esc:[/b] Abrir el menú de pausa y consultar el diario del Cuaderno de Cera.

[b][color=#C9AE7C]Cómo avanzar en cada capítulo[/color][/b]
• [b]Nivel 1 (La Plaza):[/b] Habla con los habitantes, usa el Cuaderno ([b]Q[/b]) para hallar las 3 pistas y regresa con Lucía.
• [b]Nivel 2 (La Estación):[/b] Consigue la llave de Inés, usa lámpara, caja y campana para distraer al Desvanecido (tienes 3 vidas) y activa la palanca del andén.
• [b]Nivel 3 (La Casa):[/b] Recoge los 5 objetos de las habitaciones y las ceras, combínalos en la Mesa de Encuadernación para abrir el sótano y toma la decisión final."
fit_content = true
scroll_active = false
autowrap_mode = 3

