[node name="InspectablePosters" parent="." instance=ExtResource("8_inspectable_scene")]
position = Vector2(24, 112)
object_id = "station_entrance_posters"
object_name = "Carteles desgastados (Entrada)"
inspect_text = "Carteles de antiguos recorridos ferroviarios en la entrada de la estación. Los nombres de las estaciones vecinas se han descolorido hasta ser ilegibles."
wax_reveal_text = "El Cuaderno de Cera revela el último destino registrado por Samuel: «Línea Norte — Aldeavieja»."
is_optional_exploration = true

[node name="InspectableWaitingPhotos" parent="." instance=ExtResource("8_inspectable_scene")]
position = Vector2(-188, 56)
object_id = "waiting_room_photos"
object_name = "Fotografías antiguas (Sala de espera)"
inspect_text = "Una galería de retratos de viajeros en la sala de espera. En varios marcos solo queda el fondo del andén vacío."
wax_reveal_text = "La cera dorada muestra la silueta de tu abuelo despidiendo a los viajeros con un cuaderno bajo el brazo."
is_optional_exploration = true

[node name="InspectableSchedule" parent="." instance=ExtResource("8_inspectable_scene")]
position = Vector2(-116, 48)
object_id = "waiting_room_schedule"
object_name = "Tablero de horarios"
inspect_text = "Un tablero de madera con fichas metálicas. Todas las salidas aparecen marcadas a la misma hora en que se detuvo el reloj de la plaza."
wax_reveal_text = "Al pie del tablero se lee una nota en cera: «Samuel guardó las actas junto al mecanismo de la torre»."
is_optional_exploration = true

[node name="InspectableLostBox" parent="." instance=ExtResource("8_inspectable_scene")]
position = Vector2(-188, 104)
object_id = "waiting_room_lost_box"
object_name = "Caja de objetos perdidos"
inspect_text = "Un baúl de madera lleno de boletos sin sellar, relojes de bolsillo sin agujas y cartas sin destinatario."
wax_reveal_text = "Entre los objetos brilla un sello de encuadernador idéntico al que tu abuelo usaba en su taller."
is_optional_exploration = true

